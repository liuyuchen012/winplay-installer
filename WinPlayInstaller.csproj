<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Library</OutputType>
    <AndroidApplication>true</AndroidApplication>
    <ApplicationId>com.winplay.installer</ApplicationId>
    <AndroidVersionCode>1</AndroidVersionCode>
    <ApplicationVersion>1.0</ApplicationVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- 保持构建简单快速：不做 IL 裁剪/AOT -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- 程序集直接打包进 APK，避免 Fast Deployment 依赖 -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidFastDeploymentType></AndroidFastDeploymentType>
  </PropertyGroup>

</Project>
